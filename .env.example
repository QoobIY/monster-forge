# Copy the values you need into your shell; the app does not load .env files.
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
FLASK_DEBUG=0
# auto opens the constructor with its bundled source library.
MONSTER_FORGE_MODE=auto
# Optional release directory containing media/catalog.json.
# MONSTER_FORGE_ASSET_ROOT=/path/to/asset-release
# Optional verified consumer cache (not constructor authoring products).
# MONSTER_FORGE_CACHE_ROOT=/tmp/monster-forge/consumer-cache
